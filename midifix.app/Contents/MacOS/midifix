#!/bin/zsh
set -euo pipefail

BUNDLE_DIR="$(cd "${0:A:h}/../.." && pwd)"
RESOURCE_DIR="$BUNDLE_DIR/Contents/Resources"
APP_CODE_DIR="$RESOURCE_DIR/app"
PYTHON="$RESOURCE_DIR/venv/bin/python"

if [[ ! -x "$PYTHON" || ! -f "$APP_CODE_DIR/midifix_desktop.py" ]]; then
  APP_CODE_DIR="$(cd "${0:A:h}/../../.." && pwd)"
  PYTHON="$APP_CODE_DIR/.venv/bin/python"
fi

SUPPORT_DIR="$HOME/Library/Application Support/midifix"
BLOCK_FILE="$SUPPORT_DIR/blocked_controls.txt"
PRESET_DIR="$SUPPORT_DIR/presets"
mkdir -p "$SUPPORT_DIR"

if [[ ! -f "$BLOCK_FILE" && -f "$APP_CODE_DIR/blocked_controls.txt" ]]; then
  cp "$APP_CODE_DIR/blocked_controls.txt" "$BLOCK_FILE"
fi

cd "$APP_CODE_DIR"
exec /usr/bin/arch -arm64 "$PYTHON" "$APP_CODE_DIR/midifix_desktop.py" --block-file "$BLOCK_FILE" --preset-dir "$PRESET_DIR"
